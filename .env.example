# ==========================================
# KVADRO KYIV 1 — Environment Variables
# ==========================================

# 1. PostgreSQL Database URI
# Local development:
# DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/kvadro
# Vercel / Cloud (Neon / Supabase):
DATABASE_URI=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2. Payload CMS Secret (any random 32+ char string)
PAYLOAD_SECRET=your-secure-payload-secret-key-32-chars-long

# 3. Next.js Public URL (Local or your Vercel production domain)
NEXT_PUBLIC_SERVER_URL=https://your-domain.vercel.app

# 4. Telegram Bot Notifications (Optional - can also be configured in Payload Admin)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_group_id
